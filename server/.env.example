NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/redstocks
CLIENT_URL=http://localhost:5173

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Virtual paper-trading account starting balance
STARTING_CASH=100000

# Market data provider. "demo" generates clearly-labelled demonstration data locally.
# A real provider adapter can be added under src/services/providers without UI changes.
MARKET_DATA_PROVIDER=demo
